# Application
APP_ENV=development
APP_NAME="College RAG Assistant"
APP_PORT=8000
WEB_PORT=3000

# Database & Cache
# For Docker Compose:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college_rag
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-super-secret-key-at-least-32-chars-long!
SESSION_COOKIE_NAME=college_session
SESSION_COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported: gemini, mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=

# Storage Configuration
# Supported: local, gcs
STORAGE_PROVIDER=local
STORAGE_DIR=./data/storage
STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# RAG & Ingestion Parameters
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
SIMILARITY_THRESHOLD=0.65

# Feature Flags
ENABLE_HYBRID_SEARCH=false
ENABLE_RERANKING=false
ENABLE_OPENAPI=true

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
